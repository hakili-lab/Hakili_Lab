# Hakili Lab — Configuration environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# Ne commitez JAMAIS le fichier .env

# ── Anthropic Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Modèles Claude ─────────────────────────────────────────────────────────────
# Sonnet 4.6 = meilleur rapport qualité/prix (1.7× moins cher qu'Opus 4.7)
# Pour revenir à Opus (qualité max) : claude-opus-4-8
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_OPUS=claude-opus-4-7

# ── Google Gemini — transcription vision ($0 jusqu'à 1M tokens/jour) ──────────
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
VISION_PROVIDER=gemini        # "gemini" | "claude" | "mistral"

# ── DeepSeek — correction (V3) + diagnostic (R1) + remédiation ───────────────
# Clé : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_V3=deepseek-chat
DEEPSEEK_MODEL_R1=deepseek-reasoner

# ── Mistral — diagnostic + remédiation en français académique ────────────────
# Clé : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=pixtral-12b-2409

# ── OpenAI — filet de secours GPT-5 (transcription, nom élève, correction,
# diagnostic, remédiation) ────────────────────────────────────────────────────
# Clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Choix des providers par étape ────────────────────────────────────────────
GRADING_PROVIDER=deepseek      # "deepseek" | "claude"
DIAGNOSTIC_PROVIDER=deepseek   # "deepseek" | "mistral" | "claude"
REMEDIATION_PROVIDER=mistral   # "mistral"  | "deepseek" | "claude"

# ── Seuils pipeline ────────────────────────────────────────────────────────────
CONFIDENCE_REVIEW_THRESHOLD=0.75

# ── Stockage local / divers ────────────────────────────────────────────────────
RUNS_DIR=./runs
SUBJECT=mathematics
DEBUG=false

# ── Google Sheets — source de vérité élèves/personnel (compte de service) ────
# Fichier de clé JSON du compte de service, jamais versionné (voir credentials/)
# Le personnel (enseignants, responsables, administrateur) vit dans UN SEUL
# Sheet fusionné — le rôle de chaque ligne vient de sa colonne "role".
# En local : GOOGLE_SERVICE_ACCOUNT_FILE (chemin vers un fichier existant).
# Sur Streamlit Cloud (pas de fichier local) : renseigner à la place
# GOOGLE_SERVICE_ACCOUNT_JSON avec le contenu JSON complet de la clé, en une
# seule ligne — il sera écrit dans un fichier temporaire au premier usage.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ELEVES_ID=
GOOGLE_SHEET_PERSONNEL_ID=

# ── PostgreSQL (Neon) — persistance copies/documents/notes ────────────────────
# La plus importante des variables de cette section : sans elle, aucune
# erreur bloquante ne survient (les écritures en base sont best-effort), mais
# aucune copie, document ou note n'est alors sauvegardée — perte silencieuse.
DATABASE_URL=
