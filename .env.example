# Hakili Lab — Configuration environnement
# Copiez ce fichier en .env et renseignez vos valeurs
# Ne commitez JAMAIS le fichier .env

# ── Anthropic Claude ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Modèles Claude ─────────────────────────────────────────────────────────────
# Sonnet 4.6 = meilleur rapport qualité/prix (1.7× moins cher qu'Opus 4.7)
# Pour revenir à Opus (qualité max) : claude-opus-4-8
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001

# ── Google Gemini — transcription vision ($0 jusqu'à 1M tokens/jour) ──────────
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
VISION_PROVIDER=gemini        # "gemini" | "claude"

# ── DeepSeek — correction (V3) + diagnostic (R1) + remédiation ───────────────
# Clé : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Mistral — diagnostic + remédiation en français académique ────────────────
# Clé : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ── OpenAI — filet de secours GPT-5 (transcription, nom élève, correction,
# diagnostic, remédiation) ────────────────────────────────────────────────────
# Clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# ── Choix des providers par étape ────────────────────────────────────────────
GRADING_PROVIDER=deepseek      # "deepseek" | "claude"
DIAGNOSTIC_PROVIDER=deepseek   # "deepseek" | "mistral" | "claude"

# ── Seuils pipeline ────────────────────────────────────────────────────────────
CONFIDENCE_REVIEW_THRESHOLD=0.75
IMAGE_MIN_RESOLUTION=1000
IMAGE_BLUR_THRESHOLD=100.0

# ── Stockage local ─────────────────────────────────────────────────────────────
RUNS_DIR=./runs
SUBJECT=mathematics

# ── Google Sheets — source de vérité élèves/personnel (compte de service) ────
# Fichier de clé JSON du compte de service, jamais versionné (voir credentials/)
# Le personnel (enseignants, responsables, administrateur) vit dans UN SEUL
# Sheet fusionné — le rôle de chaque ligne vient de sa colonne "role".
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEET_ELEVES_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0000000000000000
GOOGLE_SHEET_PERSONNEL_ID=1ZyXwVuTsRqPoNmLkJiHgFeDcBa0000000000000000

# ── Django (interface web — voir docs/architecture_cible.md) ─────────────────
# En développement local, mettre DEBUG=true suffit : une clé de repli est
# utilisée. Hors DEBUG, DJANGO_SECRET_KEY est OBLIGATOIRE — l'application refuse
# de démarrer sans, plutôt que de tourner avec des sessions falsifiables.
# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DEBUG=true
DJANGO_SECRET_KEY=
# Domaines autorisés en production, séparés par des virgules (ex. hakili.up.railway.app)
DJANGO_ALLOWED_HOSTS=
# Origines de confiance pour le CSRF, avec le schéma (ex. https://hakili.up.railway.app)
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── Base Neon (déjà utilisée par le pipeline, partagée avec Django) ──────────
DATABASE_URL=
